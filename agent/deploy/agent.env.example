# /etc/oe-agent/agent.env  (owner root:oeagent, chmod 640)

# Anthropic API key for the agent (console.anthropic.com, One Eighty workspace).
ANTHROPIC_API_KEY=

# Shared with Vercel as AGENT_SHARED_SECRET. Generate: openssl rand -hex 32
AGENT_SHARED_SECRET=

GCP_PROJECT_ID=

# The dashboard always reads BigQuery with the READER key at
# /etc/oe-agent/bq-sa.json (sa-frontend-reader or a dedicated Assistant
# reader; needs roles/mcp.toolUser + roles/bigquery.jobUser). Override the
# path only with DASHBOARD_BQ_KEY_FILE. CloudCLI and the terminal pick their
# own key in /etc/oe-agent/cloudcli.env.

# Where Claude Code runs; sessions are stored per this directory.
AGENT_WORKDIR=/var/lib/oe-agent/work

PORT=8787
AGENT_MAX_CONCURRENT=3
AGENT_MAX_TURNS=40
AGENT_MAX_BUDGET_USD=3
