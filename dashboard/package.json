{
  "name": "one-eighty-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "One Eighty multi-client marketing dashboard. Reads from BigQuery mart layer, restricted to @oneeighty.cz via Google SSO.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "check:creative": "tsx --tsconfig scripts/tsconfig.json scripts/check-creative-engine.ts",
    "check:queries": "tsx --tsconfig scripts/tsconfig.json scripts/check-creative-queries.ts",
    "check:warehouse": "tsx --tsconfig scripts/tsconfig.json scripts/check-warehouse.ts",
    "check:capabilities": "tsx --tsconfig scripts/tsconfig.json scripts/check-capabilities.ts",
    "check:paid": "tsx --tsconfig scripts/tsconfig.json scripts/check-paid-math.ts",
    "check:reports": "tsx --tsconfig scripts/tsconfig.json scripts/check-reports.ts",
    "check:reports-eval": "tsx --tsconfig scripts/tsconfig.json scripts/check-reports-eval.ts",
    "check:reports-authz": "tsx --tsconfig scripts/tsconfig.json scripts/check-reports-authz.ts",
    "check:reports-store": "tsx --tsconfig scripts/tsconfig.json scripts/check-reports-store.ts",
    "check:reports-url": "tsx --tsconfig scripts/tsconfig.json scripts/check-reports-url.ts",
    "check:reports-widgets": "tsx --tsconfig scripts/tsconfig.json scripts/check-reports-widgets.ts",
    "check:reports-canvas": "tsx --tsconfig scripts/tsconfig.json scripts/check-reports-canvas.ts",
