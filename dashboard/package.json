    "geist": "^1.7.2",
    "next": "^14.2.18",
    "next-auth": "^4.24.10",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^2.2.4",
    "recharts": "^2.13.0",
    "server-only": "^0.0.1",
    "zod": "^3.23.8"
